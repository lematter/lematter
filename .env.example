# Example environment variables for Lematter.
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must never be committed.

# Mailchimp (newsletter). Server-only — do not add NEXT_PUBLIC_ prefix.
# Leave empty to disable the newsletter subscribe endpoint.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
